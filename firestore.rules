rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null
        && request.auth.uid == uid;
    }

    function validPlaylist(data) {
      return data.keys().hasAll([
          'name',
          'trackIds',
          'createdAt',
          'updatedAt',
          'revision'
        ])
        && data.keys().hasOnly([
          'name',
          'description',
          'trackIds',
          'createdAt',
          'updatedAt',
          'revision'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && data.trackIds is list
        && data.trackIds.size() <= 500
        && data.createdAt is timestamp
        && data.createdAt <= request.time
        && data.updatedAt is timestamp
        && data.updatedAt <= request.time
        && data.revision is int
        && data.revision >= 1;
    }

    function validFavorite(data) {
      return data.keys().hasOnly([
          'trackId',
          'title',
          'artist',
          'artworkUri',
          'addedAt'
        ])
        && data.keys().hasAll([
          'trackId',
          'addedAt'
        ])
        && data.trackId is string
        && data.trackId.size() > 0
        && data.trackId.size() <= 200
        && (!('title' in data) || (data.title is string && data.title.size() <= 200))
        && (!('artist' in data) || (data.artist is string && data.artist.size() <= 200))
        && (!('artworkUri' in data) || (data.artworkUri is string && data.artworkUri.size() <= 1000))
        && data.addedAt is timestamp
        && data.addedAt <= request.time;
    }

    function validSubscription(data) {
      return data.keys().hasOnly([
          'provider',
          'resourceId',
          'title',
          'subscribedAt'
        ])
        && data.keys().hasAll([
          'provider',
          'resourceId',
          'subscribedAt'
        ])
        && data.provider is string
        && data.provider in ['podcast', 'radio', 'music']
        && data.resourceId is string
        && data.resourceId.size() > 0
        && data.resourceId.size() <= 200
        && (!('title' in data) || (data.title is string && data.title.size() <= 200))
        && data.subscribedAt is timestamp
        && data.subscribedAt <= request.time;
    }

    function validPreferences(data) {
      return data.keys().hasOnly([
          'shuffleEnabled',
          'repeatMode',
          'playbackSpeed',
          'crossfadeEnabled',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'shuffleEnabled',
          'repeatMode',
          'playbackSpeed',
          'crossfadeEnabled',
          'updatedAt'
        ])
        && data.shuffleEnabled is bool
        && data.repeatMode in [
          'off',
          'one',
          'all'
        ]
        && (data.playbackSpeed is int || data.playbackSpeed is float)
        && data.playbackSpeed >= 0.5
        && data.playbackSpeed <= 2.0
        && data.crossfadeEnabled is bool
        && data.updatedAt is timestamp
        && data.updatedAt <= request.time;
    }

    function validDeviceRegistration(data) {
      return data.keys().hasOnly([
          'tokenRef',
          'platform',
          'appVersion',
          'active',
          'notificationCategories',
          'marketingOptIn',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'tokenRef',
          'platform',
          'appVersion',
          'active',
          'notificationCategories',
          'marketingOptIn',
          'createdAt',
          'updatedAt'
        ])
        && data.tokenRef is string
        && data.tokenRef.size() >= 8
        && data.tokenRef.size() <= 256
        && data.platform is string
        && data.platform in ['android', 'web', 'ios']
        && data.appVersion is string
        && data.appVersion.size() > 0
        && data.appVersion.size() <= 60
        && data.active is bool
        && data.notificationCategories is list
        && data.notificationCategories.size() <= 10
        && data.marketingOptIn is bool
        && data.createdAt is timestamp
        && data.createdAt <= request.time
        && data.updatedAt is timestamp
        && data.updatedAt <= request.time;
    }

    match /users/{uid}/playlists/{playlistId} {
      allow read: if signedInAs(uid);

      allow create: if signedInAs(uid)
        && validPlaylist(request.resource.data)
        && request.resource.data.revision == 1;

      allow update: if signedInAs(uid)
        && validPlaylist(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;

      allow delete: if signedInAs(uid);
    }

    match /users/{uid}/favorites/{trackId} {
      allow read: if signedInAs(uid);

      allow create: if signedInAs(uid)
        && validFavorite(request.resource.data)
        && request.resource.data.trackId == trackId;

      allow update: if signedInAs(uid)
        && validFavorite(request.resource.data)
        && request.resource.data.trackId == trackId
        && request.resource.data.addedAt == resource.data.addedAt;

      allow delete: if signedInAs(uid);
    }

    match /users/{uid}/subscriptions/{subscriptionId} {
      allow read: if signedInAs(uid);

      allow create: if signedInAs(uid)
        && validSubscription(request.resource.data);

      allow update: if signedInAs(uid)
        && validSubscription(request.resource.data)
        && request.resource.data.provider == resource.data.provider
        && request.resource.data.resourceId == resource.data.resourceId
        && request.resource.data.subscribedAt == resource.data.subscribedAt;

      allow delete: if signedInAs(uid);
    }

    match /users/{uid}/preferences/{preferenceId} {
      allow read: if signedInAs(uid)
        && preferenceId == 'app';

      allow create, update: if signedInAs(uid)
        && preferenceId == 'app'
        && validPreferences(request.resource.data);

      allow delete: if signedInAs(uid)
        && preferenceId == 'app';
    }

    match /users/{uid}/devices/{deviceId} {
      allow read: if signedInAs(uid);

      allow create: if signedInAs(uid)
        && validDeviceRegistration(request.resource.data);

      allow update: if signedInAs(uid)
        && validDeviceRegistration(request.resource.data)
        && request.resource.data.platform == resource.data.platform
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if signedInAs(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
