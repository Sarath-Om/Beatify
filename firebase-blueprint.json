{
  "entities": {
    "PlaylistDocument": {
      "title": "PlaylistDocument",
      "description": "User-authored Beatify playlist with optimistic concurrency revision and server timestamps.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "trackIds": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 500
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "required": ["name", "trackIds", "createdAt", "updatedAt", "revision"]
    },
    "FavoriteDocument": {
      "title": "FavoriteDocument",
      "description": "User favorite track document keyed by deterministic trackId.",
      "type": "object",
      "properties": {
        "trackId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "title": { "type": "string", "maxLength": 200 },
        "artist": { "type": "string", "maxLength": 200 },
        "artworkUri": { "type": "string", "maxLength": 1000 },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["trackId", "addedAt"]
    },
    "SubscriptionDocument": {
      "title": "SubscriptionDocument",
      "description": "User subscription to a podcast show, radio station, or music feed.",
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["podcast", "radio", "music"] },
        "resourceId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "title": { "type": "string", "maxLength": 200 },
        "subscribedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["provider", "resourceId", "subscribedAt"]
    },
    "PlaybackPreferences": {
      "title": "PlaybackPreferences",
      "description": "Singleton playback preferences document stored at users/{uid}/preferences/app.",
      "type": "object",
      "properties": {
        "shuffleEnabled": { "type": "boolean" },
        "repeatMode": { "type": "string", "enum": ["off", "one", "all"] },
        "playbackSpeed": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
        "crossfadeEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shuffleEnabled", "repeatMode", "playbackSpeed", "crossfadeEnabled", "updatedAt"]
    },
    "DeviceRegistrationDocument": {
      "title": "DeviceRegistrationDocument",
      "description": "FCM push notification device registration document stored under users/{uid}/devices/{deviceId}.",
      "type": "object",
      "properties": {
        "tokenRef": { "type": "string", "minLength": 8, "maxLength": 256 },
        "platform": { "type": "string", "enum": ["android", "web", "ios"] },
        "appVersion": { "type": "string", "minLength": 1, "maxLength": 60 },
        "active": { "type": "boolean" },
        "notificationCategories": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 10
        },
        "marketingOptIn": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "tokenRef",
        "platform",
        "appVersion",
        "active",
        "notificationCategories",
        "marketingOptIn",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{uid}/playlists/{playlistId}": {
      "schema": { "$ref": "#/entities/PlaylistDocument" },
      "description": "Per-user playlists isolated by path uid."
    },
    "/users/{uid}/favorites/{trackId}": {
      "schema": { "$ref": "#/entities/FavoriteDocument" },
      "description": "Per-user favorite tracks isolated by path uid and deterministic trackId."
    },
    "/users/{uid}/subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/SubscriptionDocument" },
      "description": "Per-user podcast/radio/music subscriptions isolated by path uid."
    },
    "/users/{uid}/preferences/{preferenceId}": {
      "schema": { "$ref": "#/entities/PlaybackPreferences" },
      "description": "Per-user playback preferences singleton document ('app')."
    },
    "/users/{uid}/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/DeviceRegistrationDocument" },
      "description": "Per-user FCM device registrations isolated by path uid."
    }
  }
}
